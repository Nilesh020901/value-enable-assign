# Database connection string (e.g. Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:npg_sample@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT authentication secret
JWT_SECRET=super_secret_jwt_key_value_enable_insurance_app_2026

# AES-256 encryption key (32 bytes = 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 secret for deterministic hashing of sensitive mobile numbers
HMAC_SECRET=super_secret_hmac_hash_key_value_enable_insurance_2026

# Allowed Frontend Client Origin
CLIENT_ORIGIN=http://localhost:5173

# API Server Port
PORT=5000
